classDiagram
    class Pet {
        +String name
        +String species
        +int age
        +String health_notes
        +List~Task~ tasks
        +Pet(name, species, age, health_notes)
        +add_task(task) None
        +remove_task(task) None
        +list_tasks() List~Task~
    }

    class Owner {
        +String name
        +int available_minutes
        +int day_start_hour
        +int buffer_minutes
        +List~Pet~ pets
        +Owner(name, available_minutes, pets, day_start_hour, buffer_minutes)
        +save_to_json(tasks, filepath) None
        +load_from_json(filepath) tuple~Owner, List~Task~~
        -_task_to_dict(task) dict
        -_task_from_dict(task_data, pet_by_name) Task
    }

    class Task {
        +String title
        +int duration_minutes
        +String priority
        +Pet pet
        +String category
        +String recurrence
        +int earliest_start_minute
        +int deadline_minute
        +List~Task~ depends_on
        +String status
        +String preferred_time
        +date due_date
        +Task next_occurrence
        +priority_rank() int
        +mark_done() None
        +mark_skipped() None
        +reset() None
        +is_recurring() bool
        +clone_for_next_occurrence(due_date) Task
    }

    class ScheduledTask {
        +Task task
        +int start_minute
        +ScheduledTask(task, start_minute)
        +end_minute() int
        +time_label(day_start_hour) String
        +mark_done() None
    }

    class ConflictWarning {
        +String warning_type
        +String message
        +List~Task~ tasks
        +ConflictWarning(warning_type, message, tasks)
    }

    class Schedule {
        +List~ScheduledTask~ scheduled_tasks
        +List~Tuple~ skipped_tasks
        +int total_minutes_used
        +List~ConflictWarning~ warnings
        +add_task(st) None
