        +List~Task~ tasks
        +Scheduler(owner, tasks)
        +generate() Schedule
        +collect_next_occurrences() List~Task~
        +sort_by_time(tasks) List~Task~
        +filter_by_status(status, tasks) List~Task~
        +filter_by_pet(pet_name, tasks) List~Task~
        -_fill_gaps(schedule, minutes_used) None
        -_topological_sort(tasks) List~Task~
        -_check_duplicates(schedule) None
        -_check_time_overlaps(schedule) None
        -_check_conflicts(schedule) None
        -_sort_by_priority(tasks) List~Task~
        -_fits_in_window(task, used) bool
