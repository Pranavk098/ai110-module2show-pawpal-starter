    Owner "1" --> "0..*" Pet : owns
    Owner ..> Task : persists
    Task "0..*" --> "0..1" Pet : assigned_to
    Pet "1" --> "0..*" Task : manages
    Task "0..*" ..> "0..*" Task : depends_on
    Task --> Task : next_occurrence

    Scheduler "1" --> "1" Owner : uses
    Scheduler "1" --> "0..*" Task : processes
    Scheduler "1" ..> "1" Schedule : builds

    Schedule "1" --> "0..*" ScheduledTask : contains
    Schedule "1" --> "0..*" ConflictWarning : reports
    ScheduledTask "1" --> "1" Task : wraps
    ConflictWarning "1" --> "0..*" Task : references
