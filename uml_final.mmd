        +add_warning(warning) None
        +is_empty() bool
        +tasks_for_pet(pet) List~ScheduledTask~
        +tasks_by_priority(priority) List~ScheduledTask~
        +tasks_by_category(category) List~ScheduledTask~
        +pending_tasks() List~ScheduledTask~
        +completed_tasks() List~ScheduledTask~
        +tasks_sorted_by_start() List~ScheduledTask~
        +efficiency_score(available_minutes) float
        +priority_breakdown() dict
        +remaining_minutes(available_minutes) int
        +get_recurring_tasks_for_next_day() List~Task~
        +summary() String
    }

    class Scheduler {
